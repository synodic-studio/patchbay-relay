# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-token-here

# Your Telegram user ID (send /start to the bot to find it, then add here)
ALLOWED_USER_IDS=

# Defaults (usually don't need to change)
CLAUDE_PATH=/opt/homebrew/bin/claude
CLAUDE_WORKING_DIR=/Users/bryancostanza/Developer
CLAUDE_TIMEOUT=300

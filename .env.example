# Stargate — Environment Variable Reference
#
# Copy this file to .env and fill in your values.
# Secrets (bot token, Apple allowlist) can be loaded from macOS Keychain
# automatically if configured; the env vars here serve as fallbacks or for
# running on machines without a Keychain store.
#
# bridge.py loads .env via python-dotenv on startup.
# auth_server.py does the same.

# ---------------------------------------------------------------------------
# BRIDGE — Required
# ---------------------------------------------------------------------------

# Telegram bot token. Loaded from Keychain/Proton Pass automatically;
# only needed here as a fallback on machines without those stores.
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# BRIDGE — Optional
# ---------------------------------------------------------------------------

# Comma-separated Telegram user IDs that may interact with the bot.
# If empty, all users can send messages (not recommended in production).
# Example: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# Absolute path to the claude binary.
# Default: /opt/homebrew/bin/claude
CLAUDE_PATH=/opt/homebrew/bin/claude

# Root directory that Claude sessions run in.
# Default: ~/Developer
CLAUDE_WORKING_DIR=~/Developer

# Path to the Fanta PA plugin directory (used for Pac-Man queue routing).
# Default: ~/Developer/Fanta
PA_PLUGIN_DIR=~/Developer/Fanta

# Claude session expiry in seconds (how long idle sessions are kept alive).
# Default: 259200 (3 days)
SESSION_EXPIRY=259200

# Hard timeout for a single Claude invocation in seconds.
# Default: 2700 (45 minutes)
MAX_TIMEOUT=2700

# Maximum agentic turns per Claude invocation.
# Default: 30
MAX_TURNS=30

# Number of parallel Claude session worker threads.
# Default: 4
MAX_WORKERS=4

# Public base URL for the auth server (used to build /login links sent via Telegram).
# Default: https://auth.kj6.dev
AUTH_BASE_URL=https://auth.kj6.dev

# Set to "true" to require Sign in with Apple (or TOTP) before accepting messages.
# Default: false
AUTH_REQUIRED=false

# ---------------------------------------------------------------------------
# AUTH MODULE — Optional
# ---------------------------------------------------------------------------

# Inactivity timeout in seconds; sessions are expired if silent for this long.
# Default: 604800 (7 days)
AUTH_INACTIVITY_TIMEOUT=604800

# ---------------------------------------------------------------------------
# AUTH SERVER (auth_server.py) — Required when AUTH_REQUIRED=true
# ---------------------------------------------------------------------------

# Apple Services ID registered in Apple Developer portal.
# Example: dev.kj6.auth
APPLE_SERVICE_ID=

# Apple Developer Team ID (10-character alphanumeric).
APPLE_TEAM_ID=

# Key ID for the Sign in with Apple private key.
APPLE_KEY_ID=

# Absolute path to the .p8 private key file downloaded from Apple Developer portal.
APPLE_PRIVATE_KEY_PATH=

# Port for the auth server to listen on.
# Default: 8443
AUTH_PORT=8443

# ---------------------------------------------------------------------------
# AUTH SERVER — Optional (fallback if Keychain/Proton Pass unavailable)
# ---------------------------------------------------------------------------

# Comma-separated Apple subject IDs (from id_token `sub` claim) allowed to authenticate.
# Normally loaded from macOS Keychain item "apple-subject-allowlist".
# Example: APPLE_SUBJECT_ALLOWLIST=000000.abc123...,000000.def456...
APPLE_SUBJECT_ALLOWLIST=

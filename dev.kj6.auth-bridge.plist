<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.kj6.auth-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- UPDATE: Replace with the absolute path to your stargate checkout -->
        <string>/Users/YOURUSER/Developer/stargate/run_auth.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>WorkingDirectory</key>
    <!-- UPDATE: Replace all paths below with your stargate checkout -->
    <string>/Users/YOURUSER/Developer/stargate</string>
    <key>StandardOutPath</key>
    <string>/Users/YOURUSER/Developer/stargate/logs/auth-bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOURUSER/Developer/stargate/logs/auth-bridge.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
